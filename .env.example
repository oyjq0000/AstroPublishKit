# Optional: override the canonical production URL from astro-publish-kit.config.mjs.
SITE_URL=https://example.com

# Optional Cloudflare Web Analytics (cookieless).
PUBLIC_CF_BEACON_TOKEN=

# Optional Umami analytics.
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# Optional Giscus comments. Leave any required value empty to disable comments.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_MAPPING=pathname
