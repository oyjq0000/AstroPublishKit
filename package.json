{
  "name": "astro-publish-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A clean, static-first Astro publishing starter with SEO, search, quality gates, and Cloudflare deployment.",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:production": "node scripts/check-production-config.mjs && npm run build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:safety": "node scripts/check-safety.mjs",
    "check:template": "node scripts/check-template.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:config && npm run check:content && npm run build && npm run check:links && npm run check:sitemap && npm run check:safety && npm run check:template",
    "new-post": "node scripts/new-post.mjs",
    "drafts": "node scripts/drafts.mjs",
    "deploy:cf": "npm run build:production && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.127.1"
  }
}
