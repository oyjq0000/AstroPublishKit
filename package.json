{
  "name": "astro-publish-kit",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A clean, static-first Astro publishing starter with SEO, search, quality gates, and Cloudflare deployment.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --test tests/*.test.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:safety": "node scripts/check-safety.mjs",
    "check": "npm run typecheck && npm run test && npm run check:content && npm run check:safety && npm run build",
    "new-post": "node scripts/new-post.mjs",
    "deploy:cf": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.127.1"
  }
}
