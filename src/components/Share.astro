---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="share-row" data-share-root data-title={title}>
  <button type="button" data-share>Share</button>
  <a
    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
    rel="noopener noreferrer">X</a
  >
  <a
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
    rel="noopener noreferrer">LinkedIn</a
  >
  <span class="share-status" aria-live="polite" data-share-status></span>
</div>
<script>
  document.querySelectorAll("[data-share-root]").forEach((root) => {
    const button = root.querySelector("[data-share]");
    const status = root.querySelector("[data-share-status]");
    button?.addEventListener("click", async () => {
      const title = root.getAttribute("data-title") || document.title;
      try {
        if (navigator.share) await navigator.share({ title, url: location.href });
        else {
          await navigator.clipboard.writeText(location.href);
          if (status) status.textContent = "Link copied";
        }
      } catch {
        if (status) status.textContent = "Share cancelled";
      }
    });
  });
</script>
