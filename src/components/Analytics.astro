---
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const umamiScript = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

{
  cfToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: cfToken })}
    />
  )
}
{umamiScript && umamiId && <script is:inline defer src={umamiScript} data-website-id={umamiId} />}
