---
import Accordion from "./Accordion.astro";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="faq-section" aria-labelledby="faq-heading" data-faq>
  <h2 id="faq-heading">Frequently asked questions</h2>
  {
    items.map((item) => (
      <Accordion summary={item.question}>
        <p>{item.answer}</p>
      </Accordion>
    ))
  }
</section>

<style>
  .faq-section {
    margin-top: 3rem;
  }
</style>
