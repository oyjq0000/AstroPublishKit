---
import type { Post } from "../lib/content";
import { postUrl } from "../lib/content";

interface Props {
  previous?: Post;
  next?: Post;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav class="post-navigation" aria-label="Article navigation" data-post-navigation data-pagefind-ignore>
      {previous && (
        <a class="post-navigation-link" data-post-navigation-previous href={postUrl(previous)}>
          <span>Previous article</span>
          <strong>{previous.data.title}</strong>
        </a>
      )}
      {next && (
        <a class="post-navigation-link post-navigation-next" data-post-navigation-next href={postUrl(next)}>
          <span>Next article</span>
          <strong>{next.data.title}</strong>
        </a>
      )}
    </nav>
  )
}
