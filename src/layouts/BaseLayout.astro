---
import kit from "../../astro-publish-kit.config.mjs";
import Analytics from "../components/Analytics.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { serializeJsonLdForHtml, structuredDataGraph } from "../lib/seo.mjs";
import { absolutePageUrl } from "../lib/urls.mjs";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = kit.site.description,
  image = kit.site.brand.defaultOgImage,
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${kit.site.title}` : kit.site.title;
const canonical = absolutePageUrl(Astro.url.pathname, kit.site.url);
const imageUrl = new URL(image, `${kit.site.url}/`).href;
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: kit.site.title,
  url: new URL("/", `${kit.site.url}/`).href,
  description: kit.site.description,
};
const ldItems = jsonLd ? [websiteLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : [websiteLd];
---

<!doctype html>
<html lang={kit.site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={kit.site.brand.favicon} />
    <link rel="alternate" type="application/rss+xml" title={`${kit.site.title} RSS`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={kit.site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={kit.site.locale} />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />
      )
    }
    {
      type === "article" && modifiedTime && (
        <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />
      )
    }
    {type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("apk-theme");
        const preferred = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={serializeJsonLdForHtml(structuredDataGraph(ldItems))} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
