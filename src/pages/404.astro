---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="The requested page was not found." noindex={true}>
  <section class="shell empty-state">
    <p class="eyebrow">404</p><h1>Page not found</h1><p>The URL may have changed or the page may not exist.</p><a
      class="button"
      href="/">Return home</a
    >
  </section>
</BaseLayout>
