---
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategorySummaries, getPublishedPosts } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getCategorySummaries(posts).map((category) => ({
    params: { category: category.slug },
    props: { name: category.name, posts: posts.filter((post) => post.data.category === category.name) },
  }));
}
const { name, posts } = Astro.props;
---

<BaseLayout title={name} description={`Posts in ${name}.`}>
  <section class="shell page-header">
    <p class="eyebrow">Category</p><h1>{name}</h1><p>
      {posts.length} published {posts.length === 1 ? "post" : "posts"}.
    </p>
  </section>
  <section class="shell post-grid section-block">{posts.map((post) => <PostCard post={post} />)}</section>
</BaseLayout>
