---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategorySummaries, getPublishedPosts } from "../../lib/content";
const posts = await getPublishedPosts();
const categories = getCategorySummaries(posts);
---
<BaseLayout title="Categories" description="Browse posts by category.">
  <section class="shell page-header"><p class="eyebrow">Collections</p><h1>Categories</h1><p>Broad sections for your content library.</p></section>
  <section class="shell chip-cloud section-block">
    {categories.map((category) => <a href={`/categories/${category.slug}`}>{category.name} <span>{category.count}</span></a>)}
  </section>
</BaseLayout>
