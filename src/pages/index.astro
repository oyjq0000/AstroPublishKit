---
import kit from "../../astro-publish-kit.config.mjs";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/content";

const posts = await getPublishedPosts();
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const recent = (featured.length ? featured : posts).slice(0, 6);
---
<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">{kit.home.eyebrow}</p>
    <h1>{kit.home.heading}</h1>
    <p class="hero-copy">{kit.home.intro}</p>
    <div class="hero-actions">
      <a class="button" href={kit.home.primaryAction.href}>{kit.home.primaryAction.label}</a>
      <a class="button button-secondary" href={kit.home.secondaryAction.href}>{kit.home.secondaryAction.label}</a>
    </div>
  </section>
  <section class="shell section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Content</p>
        <h2>Recent posts</h2>
      </div>
      <a href="/archive/">Browse archive →</a>
    </div>
    <div class="post-grid">
      {recent.map((post) => <PostCard post={post} />)}
    </div>
  </section>
  <section class="shell feature-strip">
    <div><strong>Typed content</strong><span>Schema-validated Markdown and MDX.</span></div>
    <div><strong>Static search</strong><span>Pagefind, no search server required.</span></div>
    <div><strong>Deployment ready</strong><span>Cloudflare Workers Static Assets or Pages.</span></div>
  </section>
</BaseLayout>
